{
  "compilerOptions": {
    "target": "ES2022",                    // Updated: Better ESM/Node support
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,                  // Keeps build fast
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,               // Required for default imports like `import digz from 'digz'`
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,

    // Add custom types directory
    "typeRoots": ["./node_modules/@types", "./types"],

    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "types/**/*.d.ts"                     // Critical: Include custom .d.ts files
  ],
  "exclude": ["node_modules"]
}